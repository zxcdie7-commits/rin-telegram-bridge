# --- Telegram: аккаунт, на котором живёт Рин (ключи — https://my.telegram.org/apps)
TG_API_ID=
TG_API_HASH=

# --- Владелец: твой Telegram ID (узнать у @userinfobot). Только ему доступна полная Рин и команды.
ALLOWED_USERS=
# как Рин называет тебя в разговорах с другими
OWNER_NAME=Имя

# --- Голос: voice_id из ElevenLabs (Voices → нужный голос → ID). Ключ ElevenLabs — в ~/.hermes/.env
VOICE_ID=

# --- Чужие люди: 1 — Рин отвечает всем, кто пишет аккаунту (упрощённая, без доступа к компьютеру)
PUBLIC_MODE=0
PUBLIC_DAILY_PER_USER=30
PUBLIC_DAILY_TOTAL=500
# BIO=Рин — ИИ-помощница. Отвечаю автоматически.

# --- Необязательно
# HERMES_URL=http://127.0.0.1:8642
# iq | pro | local (см. MODELS в rin/config.py)
# DEFAULT_MODEL=iq
# FFMPEG=/opt/homebrew/bin/ffmpeg
# python с faster-whisper, если не тот же venv
# STT_PYTHON=
# скрипт «<script> gif <слово>» → {"file": путь} для аниме-гифок
# GIF_SCRIPT=
# runs — с подтверждениями рискованных действий; responses — старый путь
# OWNER_PATH=runs
